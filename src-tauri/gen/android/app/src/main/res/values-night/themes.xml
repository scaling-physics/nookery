<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Window background = the app's paper colour, so there is no white flash. -->
    <style name="Theme.nookery" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
