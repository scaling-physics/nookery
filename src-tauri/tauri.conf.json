{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nookery",
  "mainBinaryName": "nookery-app",
  "version": "0.2.0",
  "identifier": "dev.nookery.app",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev --port 1430",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      { "title": "Nookery", "width": 1100, "height": 760, "minWidth": 420, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
